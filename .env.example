# FCS CRM environment variables.
# There are two kinds, kept in separate files. Never commit the real files.

# ---------------------------------------------------------------------------
# 1. Tooling  →  .env
#    Used only by the scripts in scripts/ (migrations, key pulls, seeding).
#    The app never reads these. Never set them on your hosting provider.
# ---------------------------------------------------------------------------

# Supabase personal access token: https://supabase.com/dashboard/account/tokens
ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Live project ref (from the dashboard URL: supabase.com/dashboard/project/<ref>)
SUPABASE_PROJECT_REF=abcdefghijklmnopqrst

# Staging project ref, for demo data and tests. Must differ from the live ref.
SUPABASE_STAGING_PROJECT_REF=tsrqponmlkjihgfedcba

# ---------------------------------------------------------------------------
# 2. App  →  .env.local (pnpm dev, staging) or .env.production.local (pnpm start, live)
#    Don't type these by hand. Generate them:
#      pnpm env:pull --target staging                                    # writes .env.local
#      pnpm env:pull --target live                                       # writes .env.production.local
#    On Vercel or another host, set the same names in its environment settings.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co

# Safe in the browser: Row Level Security protects all data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# SERVER ONLY. Used for username sign-in, staff logins, password resets, deactivation and import files.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Recommended when running more than one server instance.
# Generate with: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# 3. Tests (optional)
#    .env.demo.local is written by `pnpm seed:demo` with the demo logins.
#    It never needs editing.
# ---------------------------------------------------------------------------

# Point Playwright at an already running server instead of starting one.
# E2E_BASE_URL=http://localhost:3000
# E2E_PORT=3100
